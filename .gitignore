# Dependencies — dev only: typescript and @types/node (PRD 6.1, zero runtime deps)
node_modules/

# TypeScript incremental check cache (tsc --noEmit, RS-TC-01)
*.tsbuildinfo

# Test and verification output
coverage/
*.lcov
test-results/
tmp/
.tmp/

# Home-directory state (RS-TC-03, RS-SC-02): these belong under the resolved
# home directory, never in a work tree, and are listed here so a stray
# REPO_SIGNAL_HOME=. run cannot stage a credential, an archive or a backup
config.json
credentials.json
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
backups/

# Forge workflow engine output — generated per run, never task work,
# excluded from work attribution and auto-commit (verify.ts ENGINE_OWNED_PREFIXES)
docs/engine-run.log
docs/artifacts/
docs/task-executions/
docs/WORKFLOW-STATE.json
docs/EXECUTION-AUDIT.jsonl

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*~
